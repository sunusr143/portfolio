# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for canonical URLs, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Inquiry delivery (Resend: https://resend.com) ---
# Delivery channels (any that are set are tried): Resend email, Web3Forms, webhook.
# With none set, the form saves to data/inquiries.jsonl on a writable disk; on Vercel it
# shows a direct-email fallback instead. Set at least one channel for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Must be a sender address on a domain verified in Resend
INQUIRY_FROM_EMAIL="Portfolio <inquiries@your-verified-domain.com>"
# Where inquiries are delivered
INQUIRY_TO_EMAIL=you@example.com

# Easiest free option, no domain needed: https://web3forms.com
# Enter your email there, get an access key, and inquiries arrive in your inbox.
WEB3FORMS_ACCESS_KEY=

# Optional: Slack/Discord/Zapier webhook URL for instant alerts, no domain needed.
INQUIRY_WEBHOOK_URL=

# --- Spam protection (Cloudflare Turnstile) ---
# Site key is public; secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: GitHub repositories section ---
# Read-only token (no scopes needed for public repos) raises the API rate limit.
# The section works without it.
GITHUB_TOKEN=
